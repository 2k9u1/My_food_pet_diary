rules_version = '2';

// Firestore 보안 규칙 — "학생은 자기 것만, 교사는 자기 학급 학생만 조회"를
// 서버(Firebase)가 강제합니다. 화면 코드를 우회해서 직접 요청을 보내도 이
// 규칙을 통과하지 못하면 거부됩니다. 여러 교사가 각자 학급을 운영할 수 있도록
// 설계되어 있습니다(학급 코드로 학생이 자기 교사를 선택).
//
// 적용 방법: Firebase 콘솔 > Firestore Database > 규칙 탭에 이 파일 내용을
// 그대로 붙여넣고 "게시"를 누르세요. (또는 Firebase CLI: firebase deploy --only firestore:rules)
//
// 역할(학생/교사)은 로그인 화면에서 본인이 직접 고르고, 그 값이 그대로
// users/{uid}.role에 저장됩니다(이메일로 검증하지 않음 — README 참고).
// isTeacher()는 "내 uid로 등록된 내 프로필의 role이 teacher인지"를 봅니다.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return isSignedIn() && myProfile().role == 'teacher';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 이 학생 문서(users/{uid})가 "나"(로그인한 교사)의 학급 학생인지.
    // resource(그 문서 자신)의 teacherId만 보고 판단합니다 — users 컬렉션을
    // 조회(list)하는 도중에 내 프로필을 또 get()으로 읽으면 Firestore가
    // 그 목록 조회 자체를 거부하는 경우가 있어서, 추가 조회 없이 판단합니다.
    function isMyStudentDoc() {
      return isSignedIn() && resource.data.teacherId == request.auth.uid;
    }

    // petState/dailyProgress/submissions 문서에 함께 저장해 둔 teacherId로,
    // 추가 조회 없이 "내 학급 학생의 데이터인지"를 확인합니다.
    function isMyStudentData() {
      return isSignedIn() && resource.data.teacherId == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isMyStudentDoc();
      // 역할은 본인이 정합니다(가입 화면에서 선택). role 값이 student/teacher
      // 둘 중 하나인지만 확인하고, 그 이상의 신원 검증은 하지 않습니다.
      allow create: if isOwner(uid) && request.resource.data.role in ['teacher', 'student'];
      // 이후 수정은 본인만, role은 만든 뒤에 바꿀 수 없습니다.
      allow update: if isOwner(uid) && request.resource.data.role == resource.data.role;
      allow delete: if false;

      match /petState/{docId} {
        allow read: if isOwner(uid) || isMyStudentData();
        allow write: if isOwner(uid);
      }

      match /dailyProgress/{docId} {
        allow read: if isOwner(uid) || isMyStudentData();
        allow write: if isOwner(uid);
      }

      match /submissions/{docId} {
        allow read: if isOwner(uid) || isMyStudentData();
        allow create: if isOwner(uid);
        allow update, delete: if false; // 제출 기록은 나중에 고치거나 지울 수 없음(판정 신뢰성)
      }

      // 미션 규칙 · 오늘의 미션 후보 목록: 그 교사(uid) 본인과, teacherId가 uid인
      // 학생만 읽을 수 있고, 고치는 것은 교사 본인만 할 수 있습니다.
      match /missionSettings/{docId} {
        allow read: if isOwner(uid) || (isSignedIn() && myProfile().teacherId == uid);
        allow write: if isOwner(uid) && isTeacher();
      }

      match /specialMissions/{docId} {
        allow read: if isOwner(uid) || (isSignedIn() && myProfile().teacherId == uid);
        allow write: if isOwner(uid) && isTeacher();
      }
    }

    // 학급 코드 -> 교사 uid. 학생이 가입할 때 코드를 조회해야 하므로 로그인한
    // 사람 누구나 읽을 수 있고, 자기 프로필을 teacher로 먼저 만든 사람만 자기
    // 코드를 등록할 수 있습니다(그래서 앱은 프로필을 먼저 만들고 코드를 나중에 등록합니다).
    match /classCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
