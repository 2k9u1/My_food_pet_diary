rules_version = '2';

// Firebase Storage 보안 규칙 — 식사 인증 사진은 자기 폴더(submissions/{내 uid}/)에만
// 올릴 수 있고, 로그인한 사람만 사진을 볼 수 있습니다(교사가 학생 사진을 확인하기 위함).
//
// 적용 방법: Firebase 콘솔 > Storage > 규칙 탭에 이 파일 내용을 그대로
// 붙여넣고 "게시"를 누르세요. (또는 Firebase CLI: firebase deploy --only storage:rules)
//
// 알아두면 좋은 점: 앱이 사진을 표시할 때 쓰는 getDownloadURL() 주소는 그 자체에
// 접근 토큰이 포함되어 있어서, 이 URL 문자열을 아는 사람은 로그인 여부와 상관없이
// 사진을 열어볼 수 있습니다(Firebase의 일반적인 동작 방식입니다). 아래 규칙은
// "누가 이 폴더를 조회/업로드할 수 있는가"를 막아주지만, 이미 발급된 URL 자체가
// 유출되는 것까지는 막지 못합니다. 학급 운영 스케일에서는 일반적으로 허용되는
// 수준이지만, 더 엄격한 보호가 필요하면 Cloud Functions로 이미지를 프록시하는
// 방식을 추후 검토하세요(이번 범위에는 포함하지 않았습니다).
service firebase.storage {
  match /b/{bucket}/o {
    match /submissions/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
