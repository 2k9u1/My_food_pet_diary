# Firebase로 실제 서비스 전환 시 사용할 설정값 예시입니다.
# 이 파일을 .env.local로 복사한 뒤 실제 값을 채워 넣으세요. (.env.local은 git에 올라가지 않습니다.)
# 지금 버전(localStorage 시연 모드)에서는 필요 없습니다.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# GEMINI_API_KEY는 여기(.env.local)에 넣지 마세요.
# 사진 분석 서버 함수(api/analyze-food.js)에서만 쓰이는 서버 전용 키라서,
# Vercel 프로젝트의 Environment Variables에 VITE_ 접두사 없이 등록해야 합니다.
# 자세한 방법은 README의 "Google Gemini API 키 만들기"를 참고하세요.
